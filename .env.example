# ==============================================================================
# MINDCARE AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and populate with your own API keys.
# ==============================================================================

# 1. Groq LPU API Key — Real-Time Conversational Clinical Interview (Sub-second response)
# Route: app/api/interview/route.js
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# 2. Google Gemini API Key 1 — Interactive Report Q&A Assistant Chatbot
# Route: app/api/report-chat/route.js
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY_REPORTCHAT=your_gemini_reportchat_key_here

# 3. Google Gemini API Key 2 — Social Insights (YouTube, Reddit, Instagram)
# Routes: app/api/social/*
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY_SOCIAL=your_gemini_social_key_here

# Platform Admin Passcode for /admin doctor approval portal
ADMIN_PASSCODE=mindcare-admin-2026

# YouTube Data API v3 & Google OAuth 2.0 (Optional - for YouTube sleep rhythm analysis)
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_OAUTH_CLIENT_ID=your_client_id.apps.googleusercontent.com
YOUTUBE_OAUTH_CLIENT_SECRET=your_client_secret
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback

# Reddit OAuth Credentials (Optional - for Reddit mood trajectory analysis)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=http://localhost:3000/api/auth/reddit/callback
REDDIT_USER_AGENT=web:mindcare-ai:v1.0
